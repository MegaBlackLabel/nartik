{
  "name": "@megablacklabel/nartik",
  "version": "0.2.0",
  "description": "Browser-native pack file system for OPFS (Origin Private File System)",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MegaBlackLabel/nartik.git"
  },
  "bugs": {
    "url": "https://github.com/MegaBlackLabel/nartik/issues"
  },
  "homepage": "https://github.com/MegaBlackLabel/nartik#readme",
  "scripts": {
    "wasm:build": "cd wasm && wasm-pack build --target web --out-dir pkg",
    "pretypecheck": "bun run wasm:build",
    "build": "bun run wasm:build && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
